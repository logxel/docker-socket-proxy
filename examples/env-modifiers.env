# Policy set entirely through the environment, for platforms that pass
# variables but not files — systemd units, Kubernetes, CI runners.
#
# Load with `docker run --env-file`, `set -a; . env-modifiers.env; set +a`, or
# a compose `env_file:` key.
#
# Lists are comma-separated. Environment rules merge after the profile and any
# allowlist file; exclusions are applied last and always win.

DOCKER_PROXY_PROFILE=read-only
DOCKER_PROXY_BIND=127.0.0.1
DOCKER_PROXY_PORT=2375

# Image inspection on top of the read-only profile's endpoints.
DOCKER_PROXY_INCLUDE_ENDPOINTS=/images/*/json,/images/*/history
DOCKER_PROXY_INCLUDE_METHODS=GET

# Logs can carry credentials an application printed at startup, and the process
# list carries whatever was passed on a command line.
DOCKER_PROXY_EXCLUDE_ENDPOINTS=/containers/*/logs,/containers/*/top

# A build context is the largest thing a client would legitimately send, and
# this policy permits no writes at all.
DOCKER_PROXY_MAX_BODY_BYTES=65536
